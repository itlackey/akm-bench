{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-4o-mini",
  "sandbox": false,
  "provider": {
    "shredder": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Shredder LM Studio (bench)",
      "options": {
        "baseURL": "http://192.168.0.205:1234/v1",
        "timeout": 600000,
        "apiKey": "$OPENAI_API_KEY"
      },
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B (Shredder LM Studio)",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "capabilities": {
            "tool": true
          }
        }
      }
    }
  }
}
